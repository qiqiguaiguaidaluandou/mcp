# ── 服务监听 ──────────────────────────────────────────────
# MCP 服务绑定的地址与端口；HOST 留空表示监听所有网卡。
MCP_HOST=
MCP_PORT=8765

# ── JWT 鉴权凭证 ──────────────────────────────────────────
# 主凭证集：除 LOGIN_URL 外的所有接口（CRM、GETSN 等）都用这一套生成 JWT。
JWT_SECRET=
JWT_ISSUER=
# LOGIN_URL 换票据专用的凭证集（与主集不同）；两项留空则回退到主集。
LOGIN_JWT_SECRET=
LOGIN_JWT_ISSUER=

# ── 登录换票据（MES）─────────────────────────────────────
# 用 LOGIN_JWT 凭证调 LOGIN_URL 登录，换取 Ticket 后再调 GETSN_URL。
LOGIN_USERNAME=
LOGIN_PASSWORD=
LOGIN_URL=
GETSN_URL=

# ── 业务接口地址 ──────────────────────────────────────────
# 以下接口均用主凭证集鉴权（post_with_jwt 默认）。
SEARCH_SN_IN_SALES_POST_ORDER_URL=
GET_DEVICE_PROFILE_URL=
GET_FQC_REPORT_URL=

# ── FQC 报告与文件下载 ────────────────────────────────────
# FQC 报告解码后落地保存的目录；留空默认 ~/fqc_reports。
FQC_REPORT_DIR=
# 服务对外可访问的基础地址，用于拼接文件下载链接。
# 远程部署时必须填真实公网/内网地址，如 https://mcp.company.com 或 http://1.2.3.4:8765
PUBLIC_BASE_URL=
